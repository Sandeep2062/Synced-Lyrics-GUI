import { Theme } from "theme.slint";
import { CoverTile, IconButton, StatusPill } from "components.slint";
import { AppHeader } from "header.slint";
import { PlayerBar } from "player_bar.slint";
import { SideLyricsPanel, LyricLine, LyricWord } from "side_lyrics_panel.slint";
import { NowPlayingView } from "now_playing_view.slint";
import { QueueDrawer } from "queue_drawer.slint";
import { TracksView, TrackData } from "tracks_view.slint";
import { AlbumsView, AlbumData } from "albums_view.slint";
import { ArtistsView, ArtistData } from "artists_view.slint";
import { SettingsView } from "settings_view.slint";
import { HealthView, HealthTrackRow, HealthResultLog, PreviewDiffItem } from "health_view.slint";
import { ManageDirectoriesDialog } from "manage_directories.slint";
import { BatchDownloadDialog, BatchLogEntry, BatchStats } from "batch_download_dialog.slint";
import { BatchDownloadPill } from "batch_download_pill.slint";
import { DownloadsView, ProviderStatus, DownloadStats } from "downloads_view.slint";
import { LogsView, LogEntry } from "logs_view.slint";

export { TrackData, AlbumData, ArtistData, LyricLine, LyricWord, BatchLogEntry, BatchStats, HealthTrackRow, HealthResultLog, PreviewDiffItem, ProviderStatus, DownloadStats, LogEntry }

export component MainWindow inherits Window {
    title: "Synced Lyrics";
    icon: @image-url("../assets/icon.png");
    default-font-family: Theme.font-family;
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 960px;
    min-height: 600px;
    background: Theme.bg-primary;
    
    // Core properties
    in-out property <int> active-tab: 0;
    in-out property <bool> queue-visible: false;
    in-out property <bool> now-playing-visible: false;
    in-out property <bool> mini-player-mode: false;
    in-out property <[TrackData]> queue-tracks: root.tracks;
    in-out property <int> current-queue-index: -1;
    in-out property <string> track-album: "";
    in-out property <string> next-track-preview: "";
    in-out property <color> dominant-color-1 <=> Theme.dominant-color-1;
    in-out property <color> dominant-color-2 <=> Theme.dominant-color-2;
    in-out property <bool> is-dark <=> Theme.is-dark;

    private property <length> queue-offset: root.queue-visible ? 340px : 0px;
    animate queue-offset { duration: 260ms; easing: ease-in-out; }

    forward-focus: lyrics_key_scope;
    lyrics_key_scope := FocusScope {
        key-pressed(event) => {
            // Per-track offset adjustment shortcuts when lyrics or now-playing is visible
            if root.lyrics-visible || root.now-playing-visible {
                if event.text == "[" {
                    root.adjust-lyrics-offset(-100);
                    return EventResult.accept;
                }
                if event.text == "]" {
                    root.adjust-lyrics-offset(100);
                    return EventResult.accept;
                }
                if event.text == "{" {
                    root.adjust-lyrics-offset(-500);
                    return EventResult.accept;
                }
                if event.text == "}" {
                    root.adjust-lyrics-offset(500);
                    return EventResult.accept;
                }
                if event.text == "-" {
                    root.adjust-lyrics-offset(-100);
                    return EventResult.accept;
                }
                if event.text == "+" || event.text == "=" {
                    root.adjust-lyrics-offset(100);
                    return EventResult.accept;
                }
                if event.text == "_" {
                    root.adjust-lyrics-offset(-500);
                    return EventResult.accept;
                }
                if event.text == "0" {
                    root.set-lyrics-offset(0);
                    return EventResult.accept;
                }
                if event.text == "s" || event.text == "S" {
                    if root.lyrics-offset-ms != 0 {
                        root.write-lyrics-offset-to-file();
                        return EventResult.accept;
                    }
                }
            }

            // Escape key: exit fullscreen now-playing, mini player, or close side panels
            if event.text == Key.Escape {
                if root.now-playing-visible {
                    root.now-playing-visible = false;
                    return EventResult.accept;
                }
                if root.mini-player-mode {
                    root.mini-player-mode = false;
                    return EventResult.accept;
                }
                if root.lyrics-visible {
                    root.lyrics-visible = false;
                    return EventResult.accept;
                }
                if root.queue-visible {
                    root.queue-visible = false;
                    return EventResult.accept;
                }
            }

            // Fullscreen Now Playing toggle
            if event.text == "f" || event.text == "F" {
                if root.has-track {
                    root.now-playing-visible = !root.now-playing-visible;
                    return EventResult.accept;
                }
            }

            // Global player keyboard navigation
            if event.text == " " {
                root.play-pause();
                return EventResult.accept;
            }
            if event.text == Key.LeftArrow {
                root.rewind();
                return EventResult.accept;
            }
            if event.text == Key.RightArrow {
                root.forward();
                return EventResult.accept;
            }
            if event.text == Key.UpArrow {
                root.volume-changed(Math.min(1.0, root.volume + 0.05));
                return EventResult.accept;
            }
            if event.text == Key.DownArrow {
                root.volume-changed(Math.max(0.0, root.volume - 0.05));
                return EventResult.accept;
            }
            if event.text == "m" || event.text == "M" {
                root.toggle-mute();
                return EventResult.accept;
            }
            if event.text == "p" || event.text == "P" {
                root.mini-player-mode = !root.mini-player-mode;
                return EventResult.accept;
            }
            if event.text == "l" || event.text == "L" {
                if root.has-track && root.has-lyrics {
                    root.lyrics-visible = !root.lyrics-visible;
                    if root.lyrics-visible {
                        root.queue-visible = false;
                    }
                }
                return EventResult.accept;
            }
            if event.text == "q" || event.text == "Q" {
                root.queue-visible = !root.queue-visible;
                if root.queue-visible {
                    root.lyrics-visible = false;
                }
                return EventResult.accept;
            }
            if event.text == "<" || event.text == "," {
                root.prev-track();
                return EventResult.accept;
            }
            if event.text == ">" || event.text == "." {
                root.next-track();
                return EventResult.accept;
            }

            EventResult.reject
        }
    }
    
    // Header properties/callbacks
    in-out property <bool> is-refreshing: false;
    in-out property <float> refresh-progress: 0.0;
    in-out property <string> refresh-text: "Refresh Directory";
    callback manage-directories();
    callback refresh();
    callback download-all();
    
    // PlayerBar properties
    in-out property <string> track-title: "";
    in-out property <string> track-subtitle: "";
    in-out property <string> position-text: "00:00";
    in-out property <string> duration-text: "00:00";
    in-out property <string> playback-icon: "▶";
    in-out property <float> seek-position: 0.0;
    in-out property <float> volume: 0.7;
    in-out property <bool> is-muted: false;
    in-out property <bool> is-playing: false;
    in-out property <bool> has-track: false;
    in-out property <bool> has-lyrics: false;
    in-out property <image> track-cover;
    in-out property <bool> has-cover: false;
    in-out property <[float]> waveform-data: [];
    
    callback play-pause();
    callback seek(float);
    callback rewind();
    callback forward();
    callback prev-track();
    callback next-track();
    callback volume-changed(float);
    callback toggle-mute();
    callback play-queue-track(int);
    
    // Lyrics Panel properties
    in-out property <bool> lyrics-visible: false;
    private property <length> lyrics-offset: root.lyrics-visible ? 390px : 0px;
    animate lyrics-offset { duration: 260ms; easing: ease-in-out; }
    in-out property <int> active-line-index: -1;
    in-out property <[LyricLine]> lyrics-lines: [];
    in-out property <string> lyrics-plain-text: "";
    in-out property <string> lyrics-status: "";
    in-out property <bool> lyrics-has-identification-suggestion: false;
    in-out property <string> lyrics-suggested-artist: "";
    in-out property <string> lyrics-suggested-title: "";
    in-out property <string> lyrics-suggested-album: "";
    in-out property <int> lyrics-suggestion-confidence: 0;
    in-out property <string> lyrics-suggestion-reason: "";
    in-out property <bool> lyrics-is-identifying: false;
    in-out property <int> lyrics-offset-ms: 0;
    in-out property <bool> active-has-words: false;
    in-out property <[LyricWord]> active-words-row1: [];
    in-out property <[LyricWord]> active-words-row2: [];
    in-out property <string> lyrics-offset-save-status: "";
    
    callback seek-to-line(int);
    callback copy-lyrics();
    callback fetch-current-lyrics();
    callback identify-current-track();
    callback accept-current-identification();
    callback ignore-current-identification();
    callback adjust-lyrics-offset(int);
    callback set-lyrics-offset(int);
    callback write-lyrics-offset-to-file();
    
    // TracksView properties
    in-out property <[TrackData]> tracks: [];
    in-out property <string> search-text: "";
    in-out property <int> status-filter: 0;
    in-out property <string> tracks-summary: "";
    
    callback select-track(int);
    callback play-track(int);
    callback fetch-track(int);
    callback identify-track(int);
    callback search-changed(string);
    callback filter-changed(int);
    
    // AlbumsView properties
    in-out property <[AlbumData]> albums: [];
    in-out property <[int]> album-rows: [];
    in-out property <bool> album-detail-mode: false;
    in-out property <int> selected-album-index: -1;
    in-out property <[TrackData]> album-tracks: [];
    in-out property <image> selected-album-cover;
    in-out property <bool> selected-album-has-cover: false;
    
    callback open-album(int);
    callback back-to-album-grid();
    callback download-album(int);
    callback play-album-track(int);
    
    // ArtistsView properties
    in-out property <[ArtistData]> artists: [];
    in-out property <int> selected-artist-index: -1;
    in-out property <[TrackData]> artist-tracks: [];
    
    callback select-artist(int);
    callback download-artist(int);
    callback play-artist-track(int);
    
    // SettingsView properties
    in-out property <[string]> settings-music-dirs: [];
    in-out property <string> settings-lrclib-url: "https://lrclib.net";
    in-out property <string> settings-musixmatch-key: "";
    in-out property <string> settings-genius-token: "";
    in-out property <bool> settings-enable-lrclib: true;
    in-out property <bool> settings-enable-musixmatch: true;
    in-out property <bool> settings-enable-netease: true;
    in-out property <bool> settings-enable-megalobiz: true;
    in-out property <bool> settings-enable-genius: true;
    in-out property <float> settings-request-interval: 1.0;
    in-out property <int> settings-cache-period-idx: 1;
    in-out property <bool> settings-scan-on-startup: false;
    in-out property <bool> settings-backup-before-overwrite: true;
    in-out property <string> settings-status: "";
    in-out property <string> updates-status: "";
    in-out property <bool> updates-checking: false;
    in-out property <string> app-version: "";
    
    callback save-settings();
    callback check-updates();
    callback open-github();

    // DownloadsView properties
    in-out property <float> downloads-progress: 0.0;
    in-out property <string> downloads-progress-text: "0/0";
    in-out property <string> downloads-eta-text: "ETA: --:--";
    in-out property <string> downloads-current-track: "";
    in-out property <[ProviderStatus]> downloads-providers: [];
    in-out property <[string]> downloads-logs: [];
    in-out property <DownloadStats> downloads-stats: { synced: 0, plain: 0, kept: 0, not-found: 0, errors: 0 };
    in-out property <bool> downloads-is-active: false;

    // LogsView properties
    in-out property <[LogEntry]> logs-entries: [];
    in-out property <int> logs-missing-count: 0;
    in-out property <int> logs-suspicious-count: 0;
    in-out property <int> logs-synced-count: 0;
    in-out property <int> logs-total-count: 0;
    in-out property <int> logs-active-subtab: 0;

    // HealthView properties
    in-out property <int> health-total-count: 0;
    in-out property <int> health-synced-count: 0;
    in-out property <int> health-plain-count: 0;
    in-out property <int> health-missing-count: 0;
    in-out property <int> health-suspicious-count: 0;
    in-out property <int> health-safe-issues-count: 0;
    in-out property <int> health-wrong-song-count: 0;
    in-out property <int> health-offset-count: 0;
    in-out property <int> health-too-short-long-count: 0;
    in-out property <bool> health-has-resumable-job: false;
    in-out property <string> health-resumable-progress-text: "";
    in-out property <bool> health-is-running: false;
    in-out property <bool> health-is-paused: false;
    in-out property <float> health-progress: 0.0;
    in-out property <string> health-progress-text: "0 / 0";
    in-out property <string> health-current-track-text: "";
    in-out property <int> health-active-view-tab: 0;
    in-out property <int> health-issue-filter: 0;
    in-out property <string> health-search-text: "";
    in-out property <[HealthTrackRow]> health-issues: [];
    in-out property <[HealthResultLog]> health-result-logs: [];
    in-out property <bool> health-preview-modal-open: false;
    in-out property <[PreviewDiffItem]> health-preview-items: [];
    in-out property <int> health-preview-selected-index: 0;

    callback health-re-audit();
    callback health-fix-all-safe();
    callback health-preview-single-issue(int);
    callback health-apply-fixes();
    callback health-cancel-preview();
    callback health-resume-batch();
    callback health-dismiss-resumable();
    callback health-pause-resume-batch();
    callback health-stop-batch();
    callback health-filter-changed(int);
    callback health-search-changed(string);
    callback health-view-tab-changed(int);
    callback health-select-preview-item(int);
    callback health-toggle-backup(bool);
    
    // Manage-directories overlay
    in-out property <bool> directories-open: false;
    callback add-directory();
    callback remove-directory(int);
    callback close-directories();

    // Batch download modal
    in-out property <bool> batch-download-open: false;
    in-out property <int> batch-download-stage: 0;
    in-out property <int> batch-total-count: 0;
    in-out property <int> batch-missing-count: 0;
    in-out property <int> batch-plain-count: 0;
    in-out property <int> batch-suspicious-count: 0;
    in-out property <string> batch-mode-title: "";
    in-out property <string> batch-phase-text: "Rescanning music directories...";
    in-out property <string> batch-current-track: "";
    in-out property <string> batch-live-status: "";
    in-out property <string> batch-live-provider: "";
    in-out property <float> batch-progress: 0.0;
    in-out property <string> batch-progress-text: "0/0";
    in-out property <BatchStats> batch-stats: { total: 0, processed: 0, remaining: 0, synced: 0, plain: 0, not-found: 0, errors: 0 };
    in-out property <[BatchLogEntry]> batch-logs: [];
    in-out property <bool> batch-is-running: false;
    in-out property <bool> batch-is-paused: false;
    in-out property <bool> batch-is-finished: false;

    callback batch-start-mode(int);
    callback batch-pause-resume();
    callback batch-stop();
    callback batch-close();

    // Suspicious lyrics actions
    in-out property <bool> lyrics-is-suspicious: false;
    in-out property <string> lyrics-suspicious-reason: "";
    in-out property <bool> lyrics-has-offset: false;
    in-out property <float> lyrics-estimated-offset: 0.0;

    callback fix-offset-tag();
    callback fix-offset-rewrite();
    callback replace-lyrics();
    
    VerticalLayout {
        // Row 0: Header
        AppHeader {
            active-tab: root.active-tab;
            tab-changed(idx) => { root.active-tab = idx; }
            manage-directories => { root.manage-directories(); }
            refresh => { root.refresh(); }
            download-all => { root.download-all(); }
            is-refreshing: root.is-refreshing;
            refresh-progress: root.refresh-progress;
            refresh-text: root.refresh-text;
            is-batch-running: root.batch-is-running;
            batch-progress: root.batch-progress;
            batch-progress-text: root.batch-progress-text;
        }
        
        // Row 1: Main Content + Animated Slide-in Right-Side Lyrics Panel & Queue Drawer
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            clip: true;

            // Main View Area (Tracks / Albums / Artists / Settings)
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width - (root.lyrics-visible ? root.lyrics-offset : (root.queue-visible ? root.queue-offset : 0px));
                height: 100%;
                clip: true;

                if root.active-tab == 0: TracksView {
                    tracks: root.tracks;
                    search-text <=> root.search-text;
                    status-filter <=> root.status-filter;
                    summary: root.tracks-summary;
                    select-track(idx) => { root.select-track(idx); }
                    play-track(idx) => { root.play-track(idx); }
                    fetch-track(idx) => { root.fetch-track(idx); }
                    identify-track(idx) => { root.identify-track(idx); }
                    search-changed(t) => { root.search-changed(t); }
                    filter-changed(idx) => { root.filter-changed(idx); }
                }
                if root.active-tab == 1: AlbumsView {
                    albums: root.albums;
                    album-rows: root.album-rows;
                    is-detail-mode: root.album-detail-mode;
                    selected-album-index: root.selected-album-index;
                    album-tracks: root.album-tracks;
                    selected-album-cover: root.selected-album-cover;
                    selected-album-has-cover: root.selected-album-has-cover;
                    open-album(idx) => { root.open-album(idx); }
                    back-to-grid => { root.back-to-album-grid(); }
                    download-album(idx) => { root.download-album(idx); }
                    play-track(idx) => { root.play-album-track(idx); }
                }
                if root.active-tab == 2: ArtistsView {
                    artists: root.artists;
                    selected-artist-index: root.selected-artist-index;
                    artist-tracks: root.artist-tracks;
                    select-artist(idx) => { root.select-artist(idx); }
                    download-artist(idx) => { root.download-artist(idx); }
                    play-track(idx) => { root.play-artist-track(idx); }
                }
                if root.active-tab == 3: HealthView {
                    total-count: root.health-total-count;
                    synced-count: root.health-synced-count;
                    plain-count: root.health-plain-count;
                    missing-count: root.health-missing-count;
                    suspicious-count: root.health-suspicious-count;
                    safe-issues-count: root.health-safe-issues-count;
                    wrong-song-count: root.health-wrong-song-count;
                    offset-count: root.health-offset-count;
                    too-short-long-count: root.health-too-short-long-count;
                    has-resumable-job: root.health-has-resumable-job;
                    resumable-progress-text: root.health-resumable-progress-text;
                    is-running: root.health-is-running;
                    is-paused: root.health-is-paused;
                    progress: root.health-progress;
                    progress-text: root.health-progress-text;
                    current-track-text: root.health-current-track-text;
                    active-view-tab <=> root.health-active-view-tab;
                    issue-filter <=> root.health-issue-filter;
                    search-text <=> root.health-search-text;
                    issues: root.health-issues;
                    result-logs: root.health-result-logs;
                    preview-modal-open <=> root.health-preview-modal-open;
                    preview-items: root.health-preview-items;
                    preview-selected-index <=> root.health-preview-selected-index;
                    backup-enabled <=> root.settings-backup-before-overwrite;
                    re-audit => { root.health-re-audit(); }
                    fix-all-safe => { root.health-fix-all-safe(); }
                    preview-single-issue(idx) => { root.health-preview-single-issue(idx); }
                    apply-fixes => { root.health-apply-fixes(); }
                    cancel-preview => { root.health-cancel-preview(); }
                    resume-batch => { root.health-resume-batch(); }
                    dismiss-resumable => { root.health-dismiss-resumable(); }
                    pause-resume-batch => { root.health-pause-resume-batch(); }
                    stop-batch => { root.health-stop-batch(); }
                    filter-changed(idx) => { root.health-filter-changed(idx); }
                    search-changed(t) => { root.health-search-changed(t); }
                    view-tab-changed(idx) => { root.health-view-tab-changed(idx); }
                    select-preview-item(idx) => { root.health-select-preview-item(idx); }
                    toggle-backup(b) => { root.health-toggle-backup(b); }
                }
                if root.active-tab == 4: SettingsView {
                    lrclib-url <=> root.settings-lrclib-url;
                    musixmatch-key <=> root.settings-musixmatch-key;
                    genius-token <=> root.settings-genius-token;
                    enable-lrclib <=> root.settings-enable-lrclib;
                    enable-musixmatch <=> root.settings-enable-musixmatch;
                    enable-netease <=> root.settings-enable-netease;
                    enable-megalobiz <=> root.settings-enable-megalobiz;
                    enable-genius <=> root.settings-enable-genius;
                    request-interval <=> root.settings-request-interval;
                    cache-period-idx <=> root.settings-cache-period-idx;
                    scan-on-startup <=> root.settings-scan-on-startup;
                    backup-before-overwrite <=> root.settings-backup-before-overwrite;
                    settings-status: root.settings-status;
                    updates-status: root.updates-status;
                    updates-checking: root.updates-checking;
                    app-version: root.app-version;
                    save-settings => { root.save-settings(); }
                    check-updates => { root.check-updates(); }
                    open-github => { root.open-github(); }
                }
                if root.active-tab == 5: DownloadsView {
                    progress: root.downloads-progress;
                    progress-text: root.downloads-progress-text;
                    eta-text: root.downloads-eta-text;
                    current-track: root.downloads-current-track;
                    providers: root.downloads-providers;
                    logs: root.downloads-logs;
                    stats: root.downloads-stats;
                    is-active: root.downloads-is-active;
                }
                if root.active-tab == 6: LogsView {
                    logs: root.logs-entries;
                    missing-count: root.logs-missing-count;
                    suspicious-count: root.logs-suspicious-count;
                    synced-count: root.logs-synced-count;
                    total-count: root.logs-total-count;
                    active-subtab: root.logs-active-subtab;
                }
            }

            // Right: Animated Slide-over Side Lyrics Panel
            SideLyricsPanel {
                x: parent.width - root.lyrics-offset;
                y: 0;
                width: 390px;
                height: 100%;
                visible: root.lyrics-offset > 0px;
                is-open: root.lyrics-visible;
                active-line-index: root.active-line-index;
                lines: root.lyrics-lines;
                plain-text: root.lyrics-plain-text;
                track-title: root.track-title;
                track-artist: root.track-subtitle;
                track-cover: root.track-cover;
                has-cover: root.has-cover;
                status: root.lyrics-status;
                is-suspicious: root.lyrics-is-suspicious;
                suspicious-reason: root.lyrics-suspicious-reason;
                has-offset: root.lyrics-has-offset;
                estimated-offset: root.lyrics-estimated-offset;
                has-identification-suggestion: root.lyrics-has-identification-suggestion;
                suggested-artist: root.lyrics-suggested-artist;
                suggested-title: root.lyrics-suggested-title;
                suggested-album: root.lyrics-suggested-album;
                suggestion-confidence: root.lyrics-suggestion-confidence;
                suggestion-reason: root.lyrics-suggestion-reason;
                is-identifying: root.lyrics-is-identifying;
                lyrics-offset-ms: root.lyrics-offset-ms;
                active-has-words: root.active-has-words;
                active-words-row1: root.active-words-row1;
                active-words-row2: root.active-words-row2;
                offset-save-status: root.lyrics-offset-save-status;

                seek-to-line(idx) => { root.seek-to-line(idx); }
                copy-lyrics => { root.copy-lyrics(); }
                close-panel => { root.lyrics-visible = false; }
                fetch-lyrics => { root.fetch-current-lyrics(); }
                fix-offset-tag => { root.fix-offset-tag(); }
                fix-offset-rewrite => { root.fix-offset-rewrite(); }
                replace-lyrics => { root.replace-lyrics(); }
                identify-track => { root.identify-current-track(); }
                accept-identification => { root.accept-current-identification(); }
                ignore-identification => { root.ignore-current-identification(); }
                adjust-offset(delta) => { root.adjust-lyrics-offset(delta); }
                set-offset(val) => { root.set-lyrics-offset(val); }
                write-offset-to-file => { root.write-lyrics-offset-to-file(); }
            }

            // Right: Animated Slide-over Play Queue Drawer
            QueueDrawer {
                x: parent.width - root.queue-offset;
                y: 0;
                width: 340px;
                height: 100%;
                visible: root.queue-offset > 0px;
                is-open: root.queue-visible;
                queue-tracks: root.queue-tracks;
                current-queue-index: root.current-queue-index;
                now-playing-title: root.track-title;
                now-playing-artist: root.track-subtitle;
                now-playing-cover: root.track-cover;
                now-playing-has-cover: root.has-cover;

                close => { root.queue-visible = false; }
                play-track(idx) => { root.play-queue-track(idx); }
                clear-queue => { root.queue-tracks = []; }
            }

            // Fullscreen Now Playing Stage Overlay
            if root.now-playing-visible: NowPlayingView {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                is-open: root.now-playing-visible;
                track-title: root.track-title;
                track-artist: root.track-subtitle;
                track-album: root.track-album;
                track-cover: root.track-cover;
                has-cover: root.has-cover;
                status: root.lyrics-status;
                is-playing: root.is-playing;
                has-track: root.has-track;
                has-lyrics: root.has-lyrics;
                seek-position: root.seek-position;
                position-text: root.position-text;
                duration-text: root.duration-text;
                waveform-data: root.waveform-data;
                volume: root.volume;
                is-muted: root.is-muted;
                active-line-index: root.active-line-index;
                lines: root.lyrics-lines;
                plain-text: root.lyrics-plain-text;
                active-has-words: root.active-has-words;
                active-words-row1: root.active-words-row1;
                active-words-row2: root.active-words-row2;
                lyrics-offset-ms: root.lyrics-offset-ms;
                offset-save-status: root.lyrics-offset-save-status;

                close => { root.now-playing-visible = false; }
                play-pause => { root.play-pause(); }
                seek(val) => { root.seek(val); }
                rewind => { root.rewind(); }
                forward => { root.forward(); }
                prev-track => { root.prev-track(); }
                next-track => { root.next-track(); }
                volume-changed(val) => { root.volume-changed(val); }
                toggle-mute => { root.toggle-mute(); }
                seek-to-line(idx) => { root.seek-to-line(idx); }
                fetch-lyrics => { root.fetch-current-lyrics(); }
                toggle-queue => { root.queue-visible = !root.queue-visible; }
                adjust-offset(delta) => { root.adjust-lyrics-offset(delta); }
                set-offset(val) => { root.set-lyrics-offset(val); }
                write-offset-to-file => { root.write-lyrics-offset-to-file(); }
            }
        }
        
        // Row 2: PlayerBar
        PlayerBar {
            track-title: root.track-title;
            track-subtitle: root.track-subtitle;
            position-text: root.position-text;
            duration-text: root.duration-text;
            playback-icon: root.playback-icon;
            seek-position: root.seek-position;
            volume: root.volume;
            is-muted: root.is-muted;
            is-playing: root.is-playing;
            has-track: root.has-track;
            has-lyrics: root.has-lyrics;
            track-cover: root.track-cover;
            has-cover: root.has-cover;
            waveform-data: root.waveform-data;
            is-lyrics-open: root.lyrics-visible;
            is-queue-open: root.queue-visible;
            next-track-preview: root.next-track-preview;

            play-pause => { root.play-pause(); }
            seek(val) => { root.seek(val); }
            rewind => { root.rewind(); }
            forward => { root.forward(); }
            prev-track => { root.prev-track(); }
            next-track => { root.next-track(); }
            volume-changed(val) => { root.volume-changed(val); }
            toggle-mute => { root.toggle-mute(); }
            toggle-lyrics => {
                root.lyrics-visible = !root.lyrics-visible;
                if root.lyrics-visible {
                    root.queue-visible = false;
                }
            }
            toggle-queue => {
                root.queue-visible = !root.queue-visible;
                if root.queue-visible {
                    root.lyrics-visible = false;
                }
            }
            toggle-mini-player => {
                root.mini-player-mode = !root.mini-player-mode;
            }
            open-now-playing => {
                root.now-playing-visible = !root.now-playing-visible;
            }
        }
    }

    // Mini-Player Floating Mode Overlay
    if root.mini-player-mode: Rectangle {
        x: parent.width - self.width - 24px;
        y: parent.height - 92px - self.height - 18px;
        width: 370px;
        height: 104px;
        border-radius: 14px;
        background: Theme.bg-card;
        border-width: 1px;
        border-color: Theme.accent-violet;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000bb;

        VerticalLayout {
            padding: 10px;
            spacing: 6px;

            HorizontalLayout {
                spacing: 10px;
                alignment: start;

                CoverTile {
                    cover: root.track-cover;
                    has-cover: root.has-cover;
                    tile-size: 40px;
                    icon-size: 18px;
                    tile-radius: 6px;
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;

                    Text {
                        text: root.has-track ? root.track-title : "No Track";
                        color: Theme.text-primary;
                        font-size: 12px;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        text: root.has-track ? root.track-subtitle : "Idle";
                        color: Theme.text-muted;
                        font-size: 10px;
                        overflow: elide;
                    }
                }

                HorizontalLayout {
                    spacing: 4px;
                    alignment: end;

                    IconButton {
                        icon: @image-url("../assets/skip_prev.svg");
                        button-size: 26px;
                        icon-size: 13px;
                        clicked => { root.prev-track(); }
                    }

                    IconButton {
                        icon: root.is-playing ? @image-url("../assets/pause.svg") : @image-url("../assets/play.svg");
                        button-size: 30px;
                        icon-size: 14px;
                        icon-color: #FFFFFF;
                        idle-tint: Theme.accent-violet;
                        clicked => { root.play-pause(); }
                    }

                    IconButton {
                        icon: @image-url("../assets/skip_next.svg");
                        button-size: 26px;
                        icon-size: 13px;
                        clicked => { root.next-track(); }
                    }

                    IconButton {
                        icon: @image-url("../assets/fullscreen.svg");
                        button-size: 26px;
                        icon-size: 12px;
                        clicked => { root.mini-player-mode = false; }
                    }
                }
            }

            // Single line active lyric snippet ticker
            HorizontalLayout {
                spacing: 6px;
                alignment: center;

                Text {
                    text: root.active-line-index >= 0 && root.active-line-index < root.lyrics-lines.length
                        ? root.lyrics-lines[root.active-line-index].text
                        : (root.has-track ? root.position-text + " / " + root.duration-text : "Select a track to play");
                    color: root.active-line-index >= 0 ? Theme.accent-cyan : Theme.text-dim;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    // Region picker, drawn last so it sits above the whole window.
    if root.directories-open: ManageDirectoriesDialog {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        directories: root.settings-music-dirs;

        add-directory => { root.add-directory(); }
        remove-directory(idx) => { root.remove-directory(idx); }
        close => { root.close-directories(); }
    }

    // Batch download modal (options selection and live progress/logs)
    if root.batch-download-open: BatchDownloadDialog {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        stage: root.batch-download-stage;
        total-count: root.batch-total-count;
        missing-count: root.batch-missing-count;
        plain-count: root.batch-plain-count;
        suspicious-count: root.batch-suspicious-count;
        mode-title: root.batch-mode-title;
        phase-text: root.batch-phase-text;
        current-track: root.batch-current-track;
        live-status: root.batch-live-status;
        live-provider: root.batch-live-provider;
        progress: root.batch-progress;
        progress-text: root.batch-progress-text;
        stats: root.batch-stats;
        logs: root.batch-logs;
        is-running: root.batch-is-running;
        is-paused: root.batch-is-paused;
        is-finished: root.batch-is-finished;

        close => { root.batch-close(); }
        start-mode(m) => { root.batch-start-mode(m); }
        pause-resume => { root.batch-pause-resume(); }
        stop => { root.batch-stop(); }
    }

    // Floating minimized pill for background batch downloads
    if (root.batch-is-running || (root.batch-is-finished && root.batch-download-stage == 1)) && !root.batch-download-open: BatchDownloadPill {
        x: parent.width - self.width - 24px - (root.lyrics-visible ? root.lyrics-offset : 0px);
        y: parent.height - 76px - self.height - 14px;
        is-running: root.batch-is-running;
        is-paused: root.batch-is-paused;
        is-finished: root.batch-is-finished;
        progress: root.batch-progress;
        progress-text: root.batch-progress-text;
        current-track: root.batch-current-track;
        synced-count: root.batch-stats.synced;
        plain-count: root.batch-stats.plain;

        clicked => { root.batch-download-open = true; }
        close => { root.batch-is-finished = false; }
    }
}
