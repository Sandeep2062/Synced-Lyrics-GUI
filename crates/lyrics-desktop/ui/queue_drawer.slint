import { Theme } from "theme.slint";
import { CoverTile, IconButton, StatusPill } from "components.slint";
import { TrackData } from "tracks_view.slint";
import { ScrollView } from "std-widgets.slint";

export component QueueDrawer inherits Rectangle {
    background: Theme.bg-surface;

    in-out property <bool> is-open: false;
    in-out property <[TrackData]> queue-tracks: [];
    in-out property <int> current-queue-index: -1;
    in-out property <string> now-playing-title: "";
    in-out property <string> now-playing-artist: "";
    in-out property <image> now-playing-cover;
    in-out property <bool> now-playing-has-cover: false;

    callback close();
    callback play-track(int);
    callback clear-queue();

    // Left border divider
    Rectangle {
        x: 0;
        y: 0;
        width: 1px;
        height: parent.height;
        background: Theme.divider;
    }

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 12px;

        // Header
        HorizontalLayout {
            height: 38px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Image {
                    source: @image-url("../assets/lyrics_icon.svg");
                    width: 18px;
                    height: 18px;
                    colorize: Theme.accent-violet;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: "Play Queue";
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                if root.queue-tracks.length > 0: Rectangle {
                    height: 18px;
                    border-radius: 9px;
                    background: Theme.accent-violet-soft;
                    border-width: 1px;
                    border-color: Theme.accent-violet;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        Text {
                            text: root.queue-tracks.length;
                            color: Theme.accent-violet;
                            font-size: 10px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 6px;
                alignment: end;

                IconButton {
                    icon: @image-url("../assets/close.svg");
                    button-size: 28px;
                    icon-size: 13px;
                    clicked => { root.close(); }
                }
            }
        }

        // Section: Now Playing Card
        if root.now-playing-title != "": VerticalLayout {
            spacing: 6px;

            Text {
                text: "NOW PLAYING";
                color: Theme.text-dim;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1px;
            }

            Rectangle {
                height: 54px;
                border-radius: Theme.radius-sm;
                background: Theme.bg-card;
                border-width: 1px;
                border-color: Theme.accent-violet;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 10px;

                    CoverTile {
                        cover: root.now-playing-cover;
                        has-cover: root.now-playing-has-cover;
                        tile-size: 38px;
                        icon-size: 16px;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        min-width: 0px;

                        Text {
                            text: root.now-playing-title;
                            color: Theme.text-primary;
                            font-size: 12px;
                            font-weight: 700;
                            overflow: elide;
                            min-width: 0px;
                        }

                        Text {
                            text: root.now-playing-artist;
                            color: Theme.accent-violet;
                            font-size: 11px;
                            overflow: elide;
                            min-width: 0px;
                        }
                    }

                    Rectangle {
                        width: 18px;
                        height: 18px;
                        y: (parent.height - self.height) / 2;

                        Image {
                            source: @image-url("../assets/play.svg");
                            width: 12px;
                            height: 12px;
                            colorize: Theme.accent-violet;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Section: Up Next
        VerticalLayout {
            vertical-stretch: 1;
            spacing: 8px;

            HorizontalLayout {
                alignment: space-between;

                Text {
                    text: "UP NEXT (" + root.queue-tracks.length + ")";
                    color: Theme.text-dim;
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }
            }

            // Queue List
            if root.queue-tracks.length > 0: ScrollView {
                width: 100%;
                height: 100%;

                VerticalLayout {
                    spacing: 4px;

                    for track[idx] in root.queue-tracks: Rectangle {
                        height: 48px;
                        border-radius: Theme.radius-sm;
                        background: q_item_ta.pressed ? Theme.bg-active : (q_item_ta.has-hover ? Theme.bg-hover : transparent);
                        border-width: 1px;
                        border-color: idx == root.current-queue-index ? Theme.accent-violet : transparent;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;

                            Text {
                                text: idx + 1;
                                color: Theme.text-dim;
                                font-size: 10px;
                                font-weight: 600;
                                width: 16px;
                                vertical-alignment: center;
                            }

                            CoverTile {
                                cover: track.cover;
                                has-cover: track.has-cover;
                                tile-size: 32px;
                                icon-size: 14px;
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                min-width: 0px;

                                Text {
                                    text: track.title;
                                    color: idx == root.current-queue-index ? Theme.accent-violet : Theme.text-primary;
                                    font-size: 12px;
                                    font-weight: 600;
                                    overflow: elide;
                                    min-width: 0px;
                                }

                                Text {
                                    text: track.artist;
                                    color: Theme.text-muted;
                                    font-size: 10px;
                                    overflow: elide;
                                    min-width: 0px;
                                }
                            }

                            Text {
                                text: track.duration;
                                color: Theme.text-dim;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                        }

                        q_item_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.play-track(idx); }
                        }
                    }
                }
            }

            // Empty queue state
            if root.queue-tracks.length == 0: VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                spacing: 8px;

                Text {
                    text: "Queue is empty";
                    color: Theme.text-dim;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Play a song from the library to queue up upcoming tracks";
                    color: Theme.text-muted;
                    font-size: 11px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
}
